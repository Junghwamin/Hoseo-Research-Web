  "info": {
    "description": "대학알리미 전임교원 연구실적 분석. core/ 의 순수 함수를 감싼다.",
    "title": "연구실적 분석 포털 API",
    "version": "6.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chart/{kind}.png": {
      "get": {
        "description": "Word 보고서에 들어가는 것과 **같은** PNG 를 돌려준다.\n\n화면 차트를 recharts 로 따로 그리면 사용자가 본 그림과 문서에 실리는\n그림이 갈라진다. Streamlit 판은 같은 PNG 를 화면과 문서가 공유했고\n(\"5종 차트를 확인하세요. 보고서에 그대로 삽입됩니다\"), 그 계약을 지킨다.\n\n추이 차트만은 화면에서 인터랙티브(recharts)로도 보여준다 — 값을 짚어\n읽는 용도다. 나머지 4종은 이 PNG 가 유일한 표현이다.",
        "operationId": "get_chart_api_chart__kind__png_get",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "university",
            "required": true,
            "schema": {
              "title": "University",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Chart",
        "tags": [
          "report"
        ]
      }
    },
