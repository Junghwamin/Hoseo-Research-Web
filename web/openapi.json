  "info": {
    "description": "대학알리미 전임교원 연구실적 분석. core/ 의 순수 함수를 감싼다.",
    "title": "연구실적 분석 포털 API",
    "version": "6.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/data": {
      "get": {
        "operationId": "get_dataset_info_api_data_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Dataset Info",
        "tags": [
          "stats"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/regions": {
      "get": {
        "operationId": "get_regions_api_regions_get",
        "parameters": [
          {
            "in": "query",
            "name": "university",
            "required": true,
            "schema": {
              "title": "University",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Regions",
        "tags": [
          "stats"
        ]
      }
    },
    "/api/stats": {
      "post": {
        "operationId": "post_stats_api_stats_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
